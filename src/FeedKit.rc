// FeedKit resources
#include <winver.h>

// Embedded manifest (id 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, type 24 = RT_MANIFEST)
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,1,2,0
PRODUCTVERSION  1,1,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FeedKit contributors"
            VALUE "FileDescription",  "FeedKit - DLSS5-Feeder game installer"
            VALUE "FileVersion",      "1.1.2.0"
            VALUE "InternalName",     "FeedKit"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "FeedKit.exe"
            VALUE "ProductName",      "FeedKit"
            VALUE "ProductVersion",   "1.1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
